# jadeejoao-api configuration — env vars only, no other config source.
# Copy to .env for local runs (cmd/api loads it best-effort; Railway injects
# real env vars and never reads this file).

# HTTP port. Railway injects PORT automatically.
PORT=8080

# Supabase Postgres via the SUPAVISOR SESSION POOLER — IPv4, port 5432.
# Railway has no outbound IPv6, so the direct connection string will not work,
# and transaction mode (port 6543) breaks pgx prepared statements. Find this
# string in Supabase → Connect → Session pooler.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase project URL (Settings → API).
SUPABASE_URL=https://<project-ref>.supabase.co

# JWKS endpoint for Supabase Auth asymmetric signing keys.
# Optional: defaults to {SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Supabase Storage S3-compatible API (Storage → Settings → S3 access keys).
# Endpoint is optional: defaults to {SUPABASE_URL}/storage/v1/s3
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=<project-region, e.g. sa-east-1>
STORAGE_S3_ACCESS_KEY=<access key id>
STORAGE_S3_SECRET_KEY=<secret access key>

# Public bucket for couple-managed content images (docs/supabase-setup.md).
STORAGE_BUCKET=site-media

# Comma-separated emails allowed into /api/v1/admin/** (the couple's
# Supabase Auth accounts).
ADMIN_EMAILS=jade@example.com,joao@example.com

# Static PIX BR Code identity: the couple's PIX key, and the holder name/city
# embedded in the copia-e-cola (fields 59/60; keep them short and accent-free).
PIX_KEY=<pix key: email, phone, CPF or EVP uuid>
PIX_MERCHANT_NAME=JADE E JOAO
PIX_MERCHANT_CITY=ATIBAIA

# RSVP email notifications via Resend (https://resend.com), per AD-15. Leave
# the API key empty to disable the feature entirely. Every submission with at
# least one "yes" emails the couple one summary with each member's answer.
RESEND_API_KEY=
RSVP_NOTIFY_EMAILS=jade@example.com,joao@example.com
# Sender identity. NOTE: Resend's sandbox sender (onboarding@resend.dev)
# delivers ONLY to the Resend account owner's own address — to reach both
# recipients above, verify a domain in Resend and use it here.
RESEND_FROM=Casamento Jade & João <onboarding@resend.dev>

# Instagram story-film chapters: posts are IMPORTED once into the public
# bucket by scripts/instagram_import.py (instagrapi) and served from there —
# the API and the site never call Instagram at runtime. These credentials are
# only read by that script, on the operator's machine:
INSTA_USERNAME=<operator instagram username>
INSTA_PASSWORD=<operator instagram password>
# Also used by the script: SUPABASE_SECRET_KEY (uploads via the Storage API).
SUPABASE_SECRET_KEY=<sb_secret_... key, Settings -> API keys>

# Comma-separated origins allowed by CORS: the two Cloudflare Pages sites
# plus the local Vite dev servers.
CORS_ORIGINS=https://<frontend>.pages.dev,https://<admin>.pages.dev,http://localhost:5173,http://localhost:5174
